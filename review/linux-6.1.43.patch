-						 inode->i_sb, xid, NULL);
-
-		if (rc != 0) {
-			cifs_dbg(FYI, "Create symlink ok, getinodeinfo fail rc = %d\n",
-				 rc);
-		} else {
-			d_instantiate(direntry, newinode);
-		}
-	}
-symlink_exit:
-	free_dentry_path(page);
-	cifs_put_tlink(tlink);
-	free_xid(xid);
-	return rc;
-}
