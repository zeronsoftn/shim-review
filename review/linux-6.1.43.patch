-		break;
-	case Opt_setuids:
-		ctx->setuids = result.negated;
-		break;
-	case Opt_intr:
-		ctx->intr = !result.negated;
-		break;
-	case Opt_setuidfromacl:
-		ctx->setuidfromacl = 1;
-		break;
-	case Opt_strictsync:
-		ctx->nostrictsync = result.negated;
-		break;
-	case Opt_serverino:
-		ctx->server_ino = !result.negated;
-		break;
-	case Opt_rwpidforward:
-		ctx->rwpidforward = 1;
-		break;
-	case Opt_modesid:
-		ctx->mode_ace = 1;
-		break;
-	case Opt_cifsacl:
