-	out.session_id = ses->Suid;
-	out.cipher_type = le16_to_cpu(ses->server->cipher_type);
-
-	/* overwrite user input with our output */
-	if (copy_to_user(in, &out, sizeof(out))) {
-		rc = -EINVAL;
-		goto out;
-	}
