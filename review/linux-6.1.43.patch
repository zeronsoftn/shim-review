-				      __FILE__, sn, ##__VA_ARGS__);	\
-	} else if ((type) & VFS) {					\
-		pr_err_ ## ratefunc("VFS: \\\\%s " fmt,			\
-				    sn, ##__VA_ARGS__);			\
