-int cifs_setup_cifs_sb(struct cifs_sb_info *cifs_sb)
-{
-	struct smb3_fs_context *ctx = cifs_sb->ctx;
-
-	INIT_DELAYED_WORK(&cifs_sb->prune_tlinks, cifs_prune_tlinks);
