-			seq_printf(s, ",srcaddr=%pI6c",
-				   &saddr6->sin6_addr);
-		else if (srcaddr->sa_family == AF_INET)
-			seq_printf(s, ",srcaddr=%pI4",
-				   &saddr4->sin_addr.s_addr);
