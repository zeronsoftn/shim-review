-		pr_err("Can't init RDMA pool: %d\n", ret);
-		return ret;
-	}
-
-	ret = smb_direct_create_qpair(st, &qp_cap);
-	if (ret) {
-		pr_err("Can't accept RDMA client: %d\n", ret);
-		return ret;
-	}
-
-	ret = smb_direct_prepare_negotiation(st);
-	if (ret) {
-		pr_err("Can't negotiate: %d\n", ret);
-		return ret;
-	}
-	return 0;
