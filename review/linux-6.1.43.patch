-static int
-cifs_show_options(struct seq_file *s, struct dentry *root)
-{
-	struct cifs_sb_info *cifs_sb = CIFS_SB(root->d_sb);
-	struct cifs_tcon *tcon = cifs_sb_master_tcon(cifs_sb);
-	struct sockaddr *srcaddr;
