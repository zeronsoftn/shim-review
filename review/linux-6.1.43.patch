-		wct = 12;
-	else {
-		wct = 10; /* old style read */
-		if ((offset >> 32) > 0)  {
-			/* can not handle this big offset for old */
-			return -EIO;
-		}
-	}
-
-	*nbytes = 0;
-	rc = small_smb_init(SMB_COM_READ_ANDX, wct, tcon, (void **) &pSMB);
