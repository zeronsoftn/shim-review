-		break;
-	case Opt_multiuser:
-		ctx->multiuser = true;
-		break;
-	case Opt_sloppy:
-		ctx->sloppy = true;
-		break;
-	case Opt_nosharesock:
-		ctx->nosharesock = true;
-		break;
-	case Opt_persistent:
